{
  "name": "card-table",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-tcg.ts",
    "dev": "concurrently -k -n api,web -c yellow,cyan \"PORT=8787 STORAGE_DIR=.storage node --watch-path=server --watch-path=shared --watch-path=data server/index.ts\" \"vite\"",
    "build": "tsc -b && vite build",
    "start": "node server/index.ts",
    "typecheck": "tsc -b",
    "deploy": "./deploy.sh",
    "preview": "tsc -b && vite build && PORT=8799 STORAGE_DIR=.storage PRICE_REFRESH_HOURS=0 node server/index.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "hono": "^4.13.19"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "gsap": "^3.15.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=24"
  }
}
